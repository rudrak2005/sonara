{
  "name": "sonora",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "typecheck:web": "pnpm --filter web exec tsc --noEmit",
    "typecheck:api": "pnpm --filter api exec tsc --noEmit",
    "test:web": "pnpm --filter web exec playwright test",
    "test:api": "pnpm --filter api test",
    "db:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "db:format": "prisma format --schema=database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema=database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=database/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=database/prisma/schema.prisma"
  }
}